<+>[options]\r\nenv_name = NH_center\r\ndynamic_name = SimpleMultirotor\r\n\r\nnavigation_3d = False\r\nusing_velocity_state = False\r\nreward_type = reward_final\r\n\r\n;depth, lgmd, vector\r\nperception = vector\r\n\r\nalgo = SAC\r\n; Enable the custom GPIDE/FOCOPS sequence SAC path for this config.\r\ntemporal_encoder = gpide\r\ntotal_timesteps = 200000\r\n\r\npolicy_name = mlp\r\nnet_arch = [64, 32, 16]\r\nactivation_function = tanh\r\ncnn_feature_num = 25\r\n\r\nkeyboard_debug = False\r\n; Disable per-step AirSim HUD logging for faster training; CSV/JSON logs are still saved.\r\nprint_train_info = False\r\ngenerate_q_map = False\r\nq_map_save_steps = 1000\r\n\r\nuse_wandb = True\r\n\r\n[wandb]\r\nname = NH-SM-2D-GPIDE-FOCOPS-SAC-M1\r\nnotes = NH_center 2D vector training\r\n\r\n[environment]\r\nmax_depth_meters = 15\r\nscreen_height = 60\r\nscreen_width = 90\r\n; Number of bounded retries before falling back to the last valid AirSim image.\r\nimage_retry_count = 3\r\n\r\ncrash_distance = 1\r\naccept_radius = 2\r\n\r\n[multirotor]\r\ndt = 0.1\r\nacc_xy_max = 2.0\r\nv_xy_max = 5\r\nv_xy_min = 0.5\r\nv_z_max = 2.0 \r\nyaw_rate_max_deg = 30.0\r\n\r\n; configs for DRL algorithms\r\n[DRL]\r\ngamma = 0.99\r\nlearning_rate = 1e-3\r\nlearning_starts = 1000\r\nbuffer_size = 50000\r\nbatch_size = 512\r\ntrain_freq = 100\r\ngradient_steps = 100\r\naction_noise_sigma = 0.1\r\n\r\n\r\n[reward]\r\n; Stronger terminal and obstacle shaping prevents high-return crash trajectories.\r\nreward_reach = 120\r\nreward_crash = -200\r\nreward_outside = -120\r\nreward_timeout = -60\r\ndistance_reward_coef = 120\r\npose_penalty_coef = 0.1\r\nobstacle_penalty_coef = 2.0\r\naction_penalty_coef = 0.1\r\nyaw_penalty_coef = 0.5\r\n\r\n[safety]\r\n; Exploration shield used only when compact obstacle features indicate close frontal obstacles.\r\nenabled = True\r\nfront_obstacle_threshold = 0.45\r\nyaw_rate_bias = 0.7\r\nspeed_scale = 0.35\r\n\r\n[constraint]\r\n; Cost signal used by GPIDE/FOCOPS. Crash is always cost 1.0.\r\nsafe_distance = 5.0\r\ncrash_cost = 1.0\r\noutside_cost = 0.5\r\naction_cost_coef = 0.05\r\nyaw_cost_coef = 0.05\r\n\r\n[GPIDE]\r\n; History length consumed by the custom sequence SAC encoder.\r\nseq_len = 16\r\nencoder_dim = 64\r\nembed_dim_per_head = 16\r\nattention_heads = 1\r\nintegral_heads = 1\r\nexp_smoothing_alphas = 0.25,0.5,1.0\r\ndecoder_hidden_size = 64\r\nobs_encode_dim = 32\r\nactor_hidden_sizes = 128,128\r\ncritic_hidden_sizes = 256,256\r\ndepth_splits = 5\r\nmax_grad_norm = 10.0\r\nuse_cuda = True\r\ntorch_num_threads = 1\r\nreward_history_scale = 100.0\r\n\r\n[FOCOPS]\r\n; FOCOPS-inspired safety/trust-region settings for the sequence SAC agent.\r\nenabled = True\r\ncost_gamma = 0.99\r\ncost_limit = 0.03\r\nnu = 1.0\r\nnu_lr = 0.05\r\nnu_max = 10.0\r\neta = 0.02\r\nkl_coef = 1.0\r\ncost_penalty_coef = 1.0\r\npolicy_snapshot_interval = 25\r\n
