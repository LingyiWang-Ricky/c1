<+>[options]\r\nenv_name = NH_center\r\ndynamic_name = SimpleMultirotor\r\n\r\nnavigation_3d = True\r\nusing_velocity_state = False\r\nreward_type = reward_final\r\n\r\n;depth, lgmd, vector\r\nperception = depth\r\n\r\nalgo = SAC\r\n; Enable the custom GPIDE/FOCOPS sequence SAC path for NH_center 3D training.\r\ntemporal_encoder = gpide\r\ntotal_timesteps = 200000\r\n\r\npolicy_name = mlp\r\nnet_arch = [64, 32, 16]\r\nactivation_function = tanh\r\ncnn_feature_num = 25\r\n\r\nkeyboard_debug = False\r\n; Disable per-step AirSim HUD logging for faster training; CSV/JSON logs are still saved.\r\nprint_train_info = False\r\ngenerate_q_map = False\r\nq_map_save_steps = 1000\r\n\r\nuse_wandb = False\r\n\r\n[wandb]\r\nname = NH-SM-3D-GPIDE-FOCOPS-SAC-M1\r\nnotes = NH_center 3D depth training\r\n\r\n[airsim]\r\n; AirSim RPC port. Match this with ApiServerPort in your AirSim settings when\r\n; running multiple simulator instances.\r\nport = 41451\r\n\r\n[environment]\r\nmax_depth_meters = 15\r\nscreen_height = 60\r\nscreen_width = 90\r\n; Number of bounded retries before falling back to the last valid AirSim image.\r\nimage_retry_count = 3\r\n; Allow the 3D NH task enough decision steps after increasing cruise speed and\r\n; yaw authority; this can be reduced again once success-rate stabilizes.\r\nmax_episode_steps = 1500\r\n\r\ncrash_distance = 1\r\naccept_radius = 2\r\n\r\n[curriculum]\r\n; NH_center 3D is much harder than the 2D/maze tasks because the initial\r\n; policy sees random yaw, random goal direction, altitude offsets and dense\r\n; obstacles.  Start with a smaller goal square/altitude change so replay gets\r\n; successful navigation examples, then expand to the full configured task.\r\nenabled = True\r\nepisodes = 800\r\nstart_ratio = 0.35\r\nmin_goal_extent = 35.0\r\nstart_z_ratio = 0.35\r\nmin_goal_z_offset_range = 0.5\r\n\r\n[multirotor]\r\ndt = 0.2\r\nacc_xy_max = 2.0\r\nv_xy_max = 8\r\nv_xy_min = 1.0\r\nv_z_max = 2.0 \r\n; Randomize 3D goals in altitude so the policy must learn vertical navigation.\r\ngoal_z_offset_range = 3.0\r\ngoal_z_offset_min = 1.0\r\nmax_vertical_difference = 5.0\r\nyaw_rate_max_deg = 60.0\r\n\r\n; configs for DRL algorithms\r\n[DRL]\r\ngamma = 0.99\r\nlearning_rate = 1e-3\r\nlearning_starts = 1000\r\nbuffer_size = 50000\r\nbatch_size = 512\r\ntrain_freq = 100\r\ngradient_steps = 100\r\naction_noise_sigma = 0.1\r\n\r\n[reward]\r\n; Stronger terminal and obstacle shaping prevents high-return crash/outside trajectories.\r\nreward_reach = 150\r\nreward_crash = -220\r\nreward_outside = -150\r\nreward_stuck = -120\r\nreward_timeout = -80\r\ndistance_reward_coef = 130\r\npose_penalty_coef = 0.1\r\nobstacle_penalty_coef = 2.0\r\naction_penalty_coef = 0.1\r\nyaw_penalty_coef = 0.5\r\nstep_penalty = 0.02\r\nno_progress_penalty = 0.2\r\nprogress_epsilon = 0.02\r\nreverse_progress_penalty_coef = 0.5\r\nmin_forward_speed = 2.0\r\nlow_speed_penalty_coef = 0.2\r\nheading_alignment_coef = 0.15\r\nheading_error_penalty_coef = 0.2\r\nboundary_penalty_coef = 2.0\r\nboundary_safe_margin = 15.0\r\npath_penalty_coef = 0.15\r\nvertical_reward_coef = 5.0\r\nvertical_error_penalty_coef = 0.5\r\n\r\n[safety]\r\n; Exploration shield used only when compact obstacle features indicate close frontal obstacles.\r\nenabled = True\r\nfront_obstacle_threshold = 0.35\r\nyaw_rate_bias = 1.0\r\nspeed_scale = 0.7\r\nmin_forward_speed = 2.0\r\ngoal_turn_bias = 0.15\r\nvertical_goal_bias = 0.25\r\n; Disable no-progress early termination for NH_center 3D curriculum training.\r\n; Otherwise early curriculum episodes that are still learning to turn/climb can\r\n; be ended as stuck before they collect useful recovery and avoidance samples.\r\nstuck_check_enabled = False\r\nmax_no_progress_steps = 200\r\nstuck_warmup_steps = 80\r\nstuck_min_progress = 0.5\r\nboundary_shield_enabled = True\r\nboundary_shield_margin = 10.0\r\nboundary_shield_speed = 2.0\r\nboundary_shield_z_speed = 0.5\r\nboundary_shield_yaw_gain = 1.5\r\n\r\n[constraint]\r\n; Cost signal used by GPIDE/FOCOPS. Crash is always cost 1.0.\r\nsafe_distance = 8.0\r\ncrash_cost = 1.0\r\noutside_cost = 1.0\r\nmax_steps_cost = 0.3\r\nstuck_cost = 0.6\r\naction_cost_coef = 0.05\r\nyaw_cost_coef = 0.05\r\nboundary_safe_margin = 15.0\r\nboundary_cost_coef = 0.8\r\n\r\n[GPIDE]\r\n; History length consumed by the custom sequence SAC encoder.\r\nseq_len = 16\r\nencoder_dim = 64\r\nembed_dim_per_head = 16\r\nattention_heads = 1\r\nintegral_heads = 1\r\nexp_smoothing_alphas = 0.25,0.5,1.0\r\ndecoder_hidden_size = 64\r\nobs_encode_dim = 32\r\nactor_hidden_sizes = 128,128\r\ncritic_hidden_sizes = 256,256\r\ndepth_splits = 9\r\nmax_grad_norm = 10.0\r\nuse_cuda = True\r\ntorch_num_threads = 1\r\nreward_history_scale = 100.0\r\n\r\n[FOCOPS]\r\n; FOCOPS-inspired safety/trust-region settings for the sequence SAC agent.\r\nenabled = True\r\ncost_gamma = 0.99\r\ncost_limit = 0.04\r\nnu = 0.5\r\nnu_lr = 0.03\r\nnu_max = 10.0\r\neta = 0.02\r\nkl_coef = 1.0\r\ncost_penalty_coef = 0.5\r\npolicy_snapshot_interval = 25\r\n
