===================================================================
diff --git a/configs/config_NH_center_SimpleMultirotor_3D.ini b/configs/config_NH_center_SimpleMultirotor_3D.ini
--- a/configs/config_NH_center_SimpleMultirotor_3D.ini	(revision 79fd0d32bad8e6684b5cd4ea44eb18f9cfa80cb9)
+++ b/configs/config_NH_center_SimpleMultirotor_3D.ini	(date 1780785336114)
@@ -9,7 +9,9 @@
 ;depth, lgmd, vector
 perception = vector
 
-algo = TD3
+algo = SAC
+; Enable the custom GPIDE/FOCOPS sequence SAC path for this config.
+temporal_encoder = gpide
 total_timesteps = 200000
 
 policy_name = mlp
@@ -18,19 +20,23 @@
 cnn_feature_num = 25
 
 keyboard_debug = False
+; Disable per-step AirSim HUD logging for faster training; CSV/JSON logs are still saved.
+print_train_info = False
 generate_q_map = False
 q_map_save_steps = 1000
 
-use_wandb = True
+use_wandb = False
 
 [wandb]
-name = NH-SM-TD3-M1-algo-compare
-notes = none
+name = NH-SM-2D-GPIDE-FOCOPS-SAC-M1
+notes = NH_center 2D vector training
 
 [environment]
 max_depth_meters = 15
 screen_height = 60
 screen_width = 90
+; Number of bounded retries before falling back to the last valid AirSim image.
+image_retry_count = 3
 
 crash_distance = 1
 accept_radius = 2
@@ -40,16 +46,83 @@
 acc_xy_max = 2.0
 v_xy_max = 5
 v_xy_min = 0.5
-v_z_max = 2.0 
+v_z_max = 2.0
 yaw_rate_max_deg = 30.0
 
 ; configs for DRL algorithms
 [DRL]
 gamma = 0.99
 learning_rate = 1e-3
-learning_starts = 2000
+learning_starts = 1000
 buffer_size = 50000
-batch_size = 1280
-train_freq = 500
-gradient_steps = 500
+batch_size = 512
+train_freq = 100
+gradient_steps = 100
 action_noise_sigma = 0.1
+
+
+[reward]
+; Stronger terminal and obstacle shaping prevents high-return crash trajectories.
+reward_reach = 120
+reward_crash = -200
+reward_outside = -120
+reward_timeout = -60
+distance_reward_coef = 120
+pose_penalty_coef = 0.1
+obstacle_penalty_coef = 2.0
+action_penalty_coef = 0.1
+yaw_penalty_coef = 0.5
+step_penalty = 0.02
+no_progress_penalty = 0.2
+progress_epsilon = 0.02
+reverse_progress_penalty_coef = 0.5
+min_forward_speed = 1.0
+low_speed_penalty_coef = 0.1
+
+[safety]
+; Exploration shield used only when compact obstacle features indicate close frontal obstacles.
+enabled = True
+front_obstacle_threshold = 0.55
+yaw_rate_bias = 0.7
+speed_scale = 0.6
+min_forward_speed = 1.0
+
+[constraint]
+; Cost signal used by GPIDE/FOCOPS. Crash is always cost 1.0.
+safe_distance = 5.0
+crash_cost = 1.0
+outside_cost = 0.5
+max_steps_cost = 0.3
+action_cost_coef = 0.05
+yaw_cost_coef = 0.05
+
+[GPIDE]
+; History length consumed by the custom sequence SAC encoder.
+seq_len = 16
+encoder_dim = 64
+embed_dim_per_head = 16
+attention_heads = 1
+integral_heads = 1
+exp_smoothing_alphas = 0.25,0.5,1.0
+decoder_hidden_size = 64
+obs_encode_dim = 32
+actor_hidden_sizes = 128,128
+critic_hidden_sizes = 256,256
+depth_splits = 5
+max_grad_norm = 10.0
+use_cuda = True
+torch_num_threads = 1
+reward_history_scale = 100.0
+
+[FOCOPS]
+; FOCOPS-inspired safety/trust-region settings for the sequence SAC agent.
+enabled = True
+cost_gamma = 0.99
+cost_limit = 0.06
+nu = 0.5
+nu_lr = 0.03
+nu_max = 10.0
+eta = 0.02
+kl_coef = 1.0
+cost_penalty_coef = 0.3
+policy_snapshot_interval = 25
